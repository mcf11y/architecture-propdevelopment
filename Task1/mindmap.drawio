        <mxCell id="I2" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" value="Искажение&#xa;ЗНАЧИТЕЛЬНЫЙ" vertex="1">
          <mxGeometry height="60" width="200" x="679" y="902" as="geometry" />
        </mxCell>
        <mxCell id="I2r" parent="1" style="rounded=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;spacing=6;" value="Изменение логов скрывает следы инцидентов; искажение результатов осмотра (client-tour-app) влияет на последующую онлайн-сделку." vertex="1">
          <mxGeometry height="110" width="380" x="1234" y="877" as="geometry" />
        </mxCell>
        <mxCell id="I3" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" value="Потеря&#xa;ЗНАЧИТЕЛЬНЫЙ" vertex="1">
          <mxGeometry height="60" width="200" x="928" y="1045" as="geometry" />
        </mxCell>
        <mxCell id="I3r" parent="1" style="rounded=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;spacing=6;" value="Утрата логов лишает возможности расследовать инциденты; для остальных данных есть резервное копирование." vertex="1">
          <mxGeometry height="110" width="380" x="1234" y="1020" as="geometry" />
