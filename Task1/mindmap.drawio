        <mxCell id="F" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;whiteSpace=wrap;html=1;" value="Конфиденциальные&#xa;данные" vertex="1">
