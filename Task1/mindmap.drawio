        <mxCell id="C" parent="1" style="rounded=1;fillColor=#1f497d;fontColor=#ffffff;strokeColor=#0d2b4d;fontSize=18;fontStyle=1;whiteSpace=wrap;html=1;" value="Безопасность&#xa;данных" vertex="1">
