        <mxCell id="I1" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" value="Утечка&#xa;ЗНАЧИТЕЛЬНЫЙ" vertex="1">
