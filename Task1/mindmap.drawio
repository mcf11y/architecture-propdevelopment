        <mxCell id="P4r" parent="1" style="rounded=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;spacing=6;" value="Каталог восстанавливается из резервных копий и внутренних систем (client-mart-estate-app)." vertex="1">
