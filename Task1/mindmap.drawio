  <diagram name="Классификация данных PropDevelopment" id="data-mindmap">
    <mxGraphModel dx="1111" dy="738" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2870" math="0" shadow="0">
