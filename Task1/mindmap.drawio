        <mxCell id="I1r" parent="1" style="rounded=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;spacing=6;" value="Системные данные и конфигурации сети облегчают злоумышленнику разведку и кибератаку на инфраструктуру; усугубляется отсутствием единых политик ИБ." vertex="1">
          <mxGeometry height="110" width="380" x="1234" y="740" as="geometry" />
